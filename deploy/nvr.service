[Unit]
Description=NVR Control Center
After=network.target

[Service]
Type=simple
User=nvr
Group=nvr
WorkingDirectory=/opt/nvr
Environment=NVR_DATA_DIR=/var/lib/nvr
Environment=NVR_RUNTIME_DIR=/opt/nvr/runtime
Environment=NVR_STORAGE_DIR=/var/lib/nvr/recordings
Environment=NVR_LISTEN=0.0.0.0:8080
Environment=NVR_SEGMENT_SECONDS=60
Environment=NVR_RETENTION_DAYS=7
Environment=NVR_STORAGE_MAX_BYTES=0
Environment=NVR_RETENTION_INTERVAL_SECONDS=300
Environment=NVR_RTSP_READ_TIMEOUT_SECONDS=15
Environment=NVR_SNAPSHOT_TIMEOUT_SECONDS=5
Environment=NVR_PRE_EVENT_SECONDS=30
Environment=NVR_WEBRTC_ENABLED=true
Environment=NVR_WEBRTC_UDP_PORT=50000
# For routed/NAT deployments, optionally set:
# Environment=NVR_WEBRTC_PUBLIC_IP=203.0.113.10
ExecStart=/opt/nvr/nvr
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nvr
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
